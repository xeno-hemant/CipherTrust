# Monorepo Environment Variables — CipherTrust Platform (Alternative Ports Setup)

# Mode configuration: set to true to run fully offline without external RPC or Pinata IPFS keys
MOCK_MODE=true
ON_CHAIN_DID_ANCHOR=true

# Server configuration
PORT=4005
NODE_ENV=development
JWT_SECRET=ciphertrust_super_secret_jwt_key_2026_change_in_production
CORS_ORIGIN=http://localhost:3005,http://localhost:3006,http://localhost:5173,http://localhost:5174

# Database (Alternative Port 5433)
DATABASE_URL=postgresql://ciphertrust:ciphertrust_pass@localhost:5433/ciphertrust_db?schema=public

# Ethereum / Web3 RPC (Alternative Port 8555)
RPC_URL=http://127.0.0.1:8555
CHAIN_ID=31337
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# External IPFS (Pinata) — optional if MOCK_MODE=true
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Local IPFS endpoint (Alternative Port 5002)
LOCAL_IPFS_URL=http://127.0.0.1:5002

# Frontend App URLs
VITE_API_URL=http://localhost:4005/api
VITE_RPC_URL=http://127.0.0.1:8555
VITE_CHAIN_ID=31337
