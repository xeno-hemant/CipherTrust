{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ciphertrust/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@ciphertrust/sdk": ["../../packages/sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../../packages/shared-types/src/**/*", "../../packages/sdk/src/**/*"]
}
